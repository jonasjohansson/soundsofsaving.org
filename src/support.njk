---
layout: base.njk
current: support
permalink: /support/
title: Support
eleventyComputed:
  description: "{{ pages.support.meta_description }}"
ogType: website
ogImage: "/assets/img/site/hug.jpg"
ogImageAlt: "Two people embracing in an auditorium"
---
{#
  Support — the page the Donate button explains. Opens on the statement (no
  page heading; the nav already said "Support"), then three "where your gift
  goes" uses (classroom / film / tour stop) and three other ways to help, each
  a single clickable card. Copy in content/pages/support.json.
#}
{% set s = pages.support %}

{% pageCss "support" %}

<div class="container support-page">
  <div class="support-lede">
    {% for para in s.lead.split("\n\n") %}
      {% if loop.first %}<h1 class="support-lead">{{ para | safe }}</h1>{% else %}<p class="support-lead">{{ para | safe }}</p>{% endif %}
    {% endfor %}
  </div>
  <p class="support-ctas"><a class="btn btn--primary" href="{{ settings.donate_url }}" target="_blank" rel="noopener">{{ s.donate.cta_label }}</a><a class="btn btn--ghost" href="#ways">Other ways to help</a></p>

  <ul class="uses grid-3">
    {% for u in s.uses %}
    <li class="use">
      {% if u.image %}{% if u.source %}<a class="use__media" href="{{ u.source }}" target="_blank" rel="noopener">{% else %}<span class="use__media">{% endif %}{% respImg u.image, { alt: u.alt, sizes: "(max-width: 760px) 92vw, 340px" } %}{% if u.source %}</a>{% else %}</span>{% endif %}{% endif %}
      <h2>{{ u.title }}</h2>
      <p>{{ u.body }}</p>
    </li>
    {% endfor %}
  </ul>


  <ul class="ways grid-3" id="ways">
    {% for w in s.other_ways %}
    <li>
      <a class="way"{% if w.cta %} href="{{ w.cta.href }}"{% endif %}>
        <h2>{{ w.title }}</h2>
        <span class="way__go">{{ w.cta.label | arrow | safe }}</span>
        <p>{{ w.body }}</p>
      </a>
    </li>
    {% endfor %}
  </ul>
</div>
