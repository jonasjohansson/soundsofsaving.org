<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {# Title: home is just the brand; inner pages get "<Title> | Sounds of Saving" #}
  {% if title %}<title>{{ title }} | {{ settings.site_title }}</title>
  {% else %}<title>{{ settings.site_title }}</title>{% endif %}

  <meta name="description" content="{{ description or settings.meta_description }}" />
  <link rel="canonical" href="{{ site.origin }}{{ canonicalOverride or page.url }}" />
  {% if robots %}<meta name="robots" content="{{ robots }}" />{% endif %}

  {# Open Graph / Twitter.

     Every page nominates a real photograph via `ogImage` in its front matter;
     `ogCard` crops it to the one shape the platforms actually want (1200x630)
     and `absImg` makes the URL fully qualified, which scrapers require.
     Dimensions are always emitted: without them Facebook and LinkedIn defer
     rendering until they have fetched and measured the file themselves, which
     is why a first share so often appears with no image at all.

     og:url follows the canonical, not page.url — the retired URLs
     (/news/, /songs/, /community/) must share as their destination rather
     than accruing a separate identity. #}
  {% set ogSrc = (ogImage or site.ogImage.src) | ogCard %}
  {% set ogAlt = ogImageAlt or (site.ogImage.alt if not ogImage) or (title or settings.site_title) %}
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ settings.site_title }}" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{ title or settings.site_title }}" />
  <meta property="og:description" content="{{ description or settings.meta_description }}" />
  <meta property="og:url" content="{{ site.origin }}{{ canonicalOverride or page.url }}" />
  <meta property="og:image" content="{{ ogSrc | absImg }}" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ ogAlt }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or settings.site_title }}" />
  <meta name="twitter:description" content="{{ description or settings.meta_description }}" />
  <meta name="twitter:image" content="{{ ogSrc | absImg }}" />
  <meta name="twitter:image:alt" content="{{ ogAlt }}" />

  <meta name="theme-color" content="#1e3ae6" />
  {# The mark is ink on transparent. iOS composites transparency onto black,
     which would hide it, so the touch icon carries the paper ground instead. #}
  <link rel="icon" href="/assets/img/site/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/img/site/apple-touch-icon.png" />

  {# "Liner Notes" — fonts are self-hosted woff2 (see fonts.css, imported by
     site.css). No Google Fonts CDN. Preload the two above-the-fold faces. #}
  <link rel="preload" href="/assets/fonts/hanken-grotesk.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/newsreader-roman.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body data-section="{{ current }}">

  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header{% if heroOverlayNav %} site-header--overlay{% endif %}" id="site-header">
    <div class="container site-header__inner">
      <a class="site-header__brand" href="/" aria-label="{{ settings.site_title }} home">
        <img class="site-header__logo" src="/assets/img/site/logo.png" width="801" height="801"
             alt="{{ settings.site_title }}" />
      </a>

      <nav class="site-nav" id="site-nav" aria-label="Primary">
        <div class="site-nav__links">
          {% for item in settings.nav %}
          <a href="{{ item.url }}"{% if current and (current == (item.url | replace('/', ''))) %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {% endfor %}
        </div>
        <div class="site-nav__cta">
          <a class="site-nav__donate" href="{{ settings.donate_url }}" target="_blank" rel="noopener">{{ settings.donate_label or "Donate" }}</a>
          <a class="btn btn--stroke" href="{{ settings.get_help_url or '/resources/' }}">Get Help</a>
        </div>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container site-footer__top">
      <p class="footer-crisis"><strong>{{ settings.crisis_line.name }}.</strong> {{ settings.crisis_line.intro }} <a href="{{ settings.crisis_line.url }}" target="_blank" rel="noopener">{{ settings.crisis_line.action }}</a></p>
    </div>
    <div class="container site-footer__inner">

      <p class="footer-fine">
        &copy; 2026 {{ settings.copyright }}
        {% if settings.privacy_url %}<a href="{{ settings.privacy_url }}">Privacy Policy</a>{% endif %}
      </p>

      <nav class="socials" aria-label="Social media">
        {% if settings.socials.youtube %}<a href="{{ settings.socials.youtube }}" target="_blank" rel="noopener">YouTube</a>{% endif %}
        {% if settings.socials.facebook %}<a href="{{ settings.socials.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
        {% if settings.socials.spotify %}<a href="{{ settings.socials.spotify }}" target="_blank" rel="noopener">Spotify</a>{% endif %}
        {% if settings.socials.twitter %}<a href="{{ settings.socials.twitter }}" target="_blank" rel="noopener">Twitter</a>{% endif %}
        {% if settings.socials.instagram %}<a href="{{ settings.socials.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
      </nav>

    </div>
  </footer>

  {# Logo-spin continuity + the brand/nav fit check. Deferred and shared across
     every page, so it is fetched once and cached. See src/assets/js/site.js. #}
  <script src="/assets/js/site.js" defer></script>

</body>
</html>
