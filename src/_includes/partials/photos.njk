{#
  Photo macros — shared by About, Educators, Impact (rows) and Programs (a
  single figure beside a group head).

  Each photo is { src, alt, caption, source }. `source` is the URL the image
  came from (an Instagram post, for the ones pulled from the SoS account); when
  it is set both the image and the caption link back to it. Styling lives in site.css
  (.photo-row) so both shapes look the same.
#}

{% macro media(ph, eager) %}
  {%- if ph.source -%}
    <a class="photo" href="{{ ph.source }}" target="_blank" rel="noopener"><img src="{{ ph.src }}" alt="{{ ph.alt }}"{% if not eager %} loading="lazy"{% endif %} decoding="async" /></a>
  {%- else -%}
    <span class="photo"><img src="{{ ph.src }}" alt="{{ ph.alt }}"{% if not eager %} loading="lazy"{% endif %} decoding="async" /></span>
  {%- endif -%}
{% endmacro %}

{% macro caption(ph) %}
  {%- if ph.caption -%}
    <figcaption>
      {%- if ph.source -%}
        <a href="{{ ph.source }}" target="_blank" rel="noopener">{{ ph.caption }}</a>
      {%- else -%}
        {{ ph.caption }}
      {%- endif -%}
    </figcaption>
  {%- endif -%}
{% endmacro %}

{# A row of photos. `eager` skips lazy-loading for rows above the fold. #}
{% macro row(photos, eager) %}
  {%- if photos.length -%}
  <ul class="photo-row" aria-label="Photos">
    {%- for ph in photos %}
    <li>
      <figure>
        {{ media(ph, eager) }}
        {{ caption(ph) }}
      </figure>
    </li>
    {%- endfor %}
  </ul>
  {%- endif -%}
{% endmacro %}

{# One photo, used beside a section head. #}
{% macro figure(ph, className) %}
  {%- if ph -%}
  <figure class="{{ className or 'photo-figure' }}">
    {{ media(ph) }}
    {{ caption(ph) }}
  </figure>
  {%- endif -%}
{% endmacro %}
