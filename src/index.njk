---
layout: base.njk
current: home
permalink: /
title: ""
heroOverlayNav: true
eleventyComputed:
  description: "{{ settings.seo.home or settings.meta_description }}"
---
{#
  Home — message-first. Section order:
  1. Hero — positioning line over a full-color artist still + three doors
  2. What we do (Artists / Schools / Community)
  3. Featured session (randomized client-side)
  4. Featured interview (randomized client-side)
  5. Where your gift goes — the closing ask, on the dark band
  Hero + featured session/interview re-personalize on each load via the pools below.
#}
{% set featured = sessions | selectattr("featured") | first %}
{% set hero = featured or sessions | first %}

<style>
  /* — 1. Hero — full-color artist still, one positioning line, one CTA ——— */
  .home-hero {
    position: relative;
    min-height: min(92vh, 760px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }
  .home-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    z-index: 0;
  }
  /* Restrained legibility gradient — bottom + left only, keeps the image
     essentially full-color (the whole point: re-personalize, no flat wash). */
  .home-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(rgba(20,16,28,0.24), rgba(20,16,28,0.24)),
      linear-gradient(180deg, rgba(20,16,28,0.24) 0%, rgba(20,16,28,0) 24%),
      linear-gradient(0deg, rgba(20,16,28,0.84) 0%, rgba(20,16,28,0.6) 34%, rgba(20,16,28,0.28) 58%, rgba(20,16,28,0) 82%);
  }
  .home-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: var(--space-2xl);
  }
  /* Mobile: the header (logo + stacked nav) overlays the top of the hero, so
     make the hero full-height and keep its content at the bottom, clear of it. */
  @media (max-width: 860px) {
    .home-hero { min-height: 100svh; }
    .home-hero__inner { padding-bottom: var(--space-xl); }
  }
  .home-hero__eyebrow { color: var(--paper); margin: 0 0 var(--space-sm); }
  .home-hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    line-height: var(--lh-tight);
    font-weight: var(--fw-semibold);
    margin: 0;
    max-width: 22ch;
    color: var(--paper);
    text-wrap: balance;
  }
  .home-hero__sub {
    margin: var(--space-md) 0 0;
    max-width: 60ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-base);
    color: var(--paper);
  }
  .home-hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }
  .home-hero__ghost { border-color: var(--paper); color: var(--paper); }
  .home-hero__ghost:hover { background: var(--paper); color: var(--ink); }
  /* Photo credit sits in the corner of the image, not in the copy column. */
  .home-hero__credit {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    margin: 0;
    padding: var(--space-xs) var(--space-md);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--paper);
    opacity: 0.55;
  }

  /* — Shared section heads ——————————————————————————————————————— */
  .home-head { max-width: var(--maxw-prose); margin-bottom: var(--space-lg); }
  .home-head__title { font-family: var(--font-display); font-size: var(--fs-title); line-height: var(--lh-tight); margin: var(--space-2xs) 0 0; }
  .home-head__intro { font-size: var(--fs-lead); line-height: var(--lh-base); color: var(--text-muted); margin: var(--space-sm) 0 0; }
  .home-more {
    display: inline-block;
    margin-top: var(--space-lg);
    color: var(--accent);
    font-weight: var(--fw-regular);
  }
  .home-more:hover { text-decoration: underline; }
  /* — Three doors (in the hero) ———————————————————————————————— */
  .home-doors { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xs); margin-top: var(--space-lg); list-style: none; padding: 0; max-width: 60rem; }
  .home-doors > li { display: flex; }
  .home-door {
    flex: 1;
    display: block;
    border: 1px solid rgba(255,255,255,0.55);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
    color: var(--paper);
    text-decoration: none;
    background: rgba(20,16,28,0.28);
    transition: background var(--transition), border-color var(--transition);
  }
  .home-door:hover, .home-door:focus-visible { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .home-door__q { display: block; font-family: var(--font-display); font-weight: var(--fw-semibold); font-size: var(--fs-h3); line-height: var(--lh-tight); }
  .home-door__a { display: block; font-size: var(--fs-small); margin-top: var(--space-3xs); opacity: 0.85; }
  @media (max-width: 760px) { .home-doors { grid-template-columns: 1fr; } }

  /* — What we do: Artists / Schools / Community ———————————————— */
  .home-what { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  .home-what__media { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); background: var(--bg-alt); margin-bottom: var(--space-sm); }
  .home-what__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .home-what--artists { --accent: var(--accent-sessions); }
  .home-what--schools { --accent: var(--accent-educators); }
  .home-what--community { --accent: var(--accent-programs); }
  .home-what__title { font-family: var(--font-display); font-size: var(--fs-h3); line-height: var(--lh-tight); margin: var(--space-2xs) 0 var(--space-xs); }
  .home-what__copy { color: var(--text-muted); line-height: var(--lh-base); margin: 0; font-size: var(--fs-small); }
  .home-what .home-more { margin-top: var(--space-sm); }
  @media (max-width: 760px) { .home-what { grid-template-columns: 1fr; } }


  /* — Where your gift goes: the one ask on the page, so it gets the dark
     band the site uses elsewhere for a change of register. ——————————— */
  .home-gift-band { background: var(--dusk); color: var(--on-dark); }
  .home-gift-band .home-head__title { color: var(--on-dark); }
  .home-gift-band .home-head__intro { color: var(--paper-2); }
  .home-gift-band .home-gift__use { border-top-color: var(--dusk-2); }
  .home-gift-band .home-gift__use b { color: var(--accent-bright); }
  .home-gift-band .home-gift__use p { color: var(--paper-2); }
  .home-gift-band .btn--primary { background: var(--paper); color: var(--dusk); }
  .home-gift-band .btn--primary:hover { background: var(--accent-bright); color: var(--dusk); }
  .home-gift-band .btn--ghost { border-color: var(--paper); color: var(--paper); }
  .home-gift-band .btn--ghost:hover { background: var(--paper); color: var(--dusk); }

  .home-gift { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-xl); align-items: start; }
  .home-gift__uses { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  .home-gift__use { display: grid; grid-template-columns: 7rem 1fr; gap: var(--space-sm); padding-top: var(--space-sm); border-top: 1px solid var(--line); }
  .home-gift__use b { font-family: var(--font-display); font-weight: var(--fw-semibold); color: var(--accent); }
  .home-gift__use p { margin: 0; font-size: var(--fs-small); line-height: var(--lh-base); color: var(--text-muted); }
  .home-gift__ctas { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-md); }
  @media (max-width: 760px) { .home-gift { grid-template-columns: 1fr; } }

  /* — Featured session / interview ——————————————————————————————— */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    grid-template-areas: "media meta" "links meta";
    gap: var(--space-md) var(--space-xl);
    align-items: start;
  }
  .featured__media { grid-area: media; }
  .featured__meta  { grid-area: meta; }
  .featured__links { grid-area: links; }
  /* Mobile: stack thumbnail, then artist/title, then the links. */
  @media (max-width: 720px) {
    .featured {
      grid-template-columns: 1fr;
      grid-template-areas: "media" "meta" "links";
    }
  }
  .featured__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-alt);
  }
  .featured__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Story/interview images vary in aspect ratio, so show them in full (uncropped). */
  .featured--story .featured__media { aspect-ratio: 16 / 9; }
  .featured--story .featured__media img { height: 100%; object-fit: cover; }
  .featured__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--paper);
  }
  .featured__play svg { width: 64px; height: 64px; filter: drop-shadow(var(--shadow-play)); opacity: 0.95; }
  .featured__artist { font-family: var(--font-display); font-size: var(--fs-h2); line-height: var(--lh-tight); margin: var(--space-2xs) 0 0; }
  .featured__song { font-size: var(--fs-lead); color: var(--text-muted); margin: var(--space-3xs) 0 0; }
  .featured__links { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xs); margin-top: var(--space-md); }
  .featured__links .home-more { margin-top: 0; }

</style>

{# 1. HERO ——————————————————————————————————————————————————————— #}
<section class="home-hero">
  {% if hero.thumbnail %}
  {% set heroBase = hero.thumbnail | replace(".jpg", "") %}
  <img class="home-hero__img media media--full"
       src="{{ heroBase }}-1280.webp"
       srcset="{{ heroBase }}-800.webp 800w, {{ heroBase }}-1280.webp 1280w, {{ heroBase }}-1920.webp 1920w"
       sizes="100vw"
       alt="{{ hero.artist }} performing for Sounds of Saving"
       {% if hero.dims %}width="{{ hero.dims.width }}" height="{{ hero.dims.height }}"{% endif %}
       fetchpriority="high" decoding="async" />
  {% endif %}
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="home-hero__inner">
    <div class="container">
      <h1 class="home-hero__title">{{ settings.hero_heading }}</h1>
      <p class="home-hero__sub">{{ settings.hero_subheading }}</p>
      <ul class="home-doors" aria-label="Where do you want to go?">
        <li><a class="home-door" href="/sessions/"><span class="home-door__q">I love music</span><span class="home-door__a">Watch artists share the song that got them through &rarr;</span></a></li>
        <li><a class="home-door" href="/educators/"><span class="home-door__q">I work at a school</span><span class="home-door__a">Bring SoS HS, our five-session program, to your students &rarr;</span></a></li>
        <li><a class="home-door" href="/resources/"><span class="home-door__q">I need help</span><span class="home-door__a">Resources and the 988 Lifeline &rarr;</span></a></li>
      </ul>
    </div>
  </div>
  <p class="home-hero__credit">{% if hero.artist %}Pictured: {{ hero.artist }}{% if hero.song_title %}, &ldquo;{{ hero.song_title }}&rdquo;{% endif %}{% endif %}</p>
</section>

{# 2. WHAT WE DO — Artists / Schools / Community + proof strip ———— #}
<section class="section">
  <div class="container">
    <header class="home-head">
      <h2 class="home-head__title">What we do</h2>
      <p class="home-head__intro">Young people already use music to cope. We work with the artists they trust, the schools they're in, and the shows they go to, so they can use it on purpose.</p>
    </header>
    <ul class="home-what">
      <li class="home-what--artists">
        <a class="home-what__media" href="/sessions/" aria-label="Sessions"><img src="/assets/img/site/home-artists.jpg" alt="An artist filming a Song That Found Me at the Right Time session" width="1400" height="1750" decoding="async" /></a>
        <h3 class="home-what__title">Artists</h3>
        <p class="home-what__copy">Song That Found Me at the Right Time: an artist covers the song that got them through a hard time and talks about what else helped. Made with the 988 Lifeline.</p>
        <a class="home-more" href="/sessions/">Watch a Session &rarr;</a>
      </li>
      <li class="home-what--schools">
        <a class="home-what__media" href="/educators/" aria-label="For educators"><img src="/assets/img/site/home-schools.jpg" alt="Musicians visiting a high school for SoS HS" width="1400" height="1750" decoding="async" /></a>
        <h3 class="home-what__title">Schools</h3>
        <p class="home-what__copy">SoS HS: five sessions on coping, identity, and connection, built on the music students already listen to. Run by school staff or by us.</p>
        <a class="home-more" href="/educators/">Bring it to your school &rarr;</a>
      </li>
      <li class="home-what--community">
        <a class="home-what__media" href="/programs/#community" aria-label="Community programs"><img src="/assets/img/site/home-community.jpg" alt="Fans at a festival holding Songs That Found Me cards" width="1400" height="1750" decoding="async" /></a>
        <h3 class="home-what__title">Community</h3>
        <p class="home-what__copy">At tours and festivals we collect the songs that found people at the right time, with a clinician at the table and a QR code to local help.</p>
        <a class="home-more" href="/programs/#community">See the programs &rarr;</a>
      </li>
    </ul>
  </div>
</section>

{# 3. FEATURED SESSION ——————————————————————————————————————————— #}
{% if featured %}
<section class="section section--alt">
  <div class="container">
    <header class="home-head">
      <h2 class="home-head__title">Song That Found Me at the Right Time</h2>
    </header>
    <div class="featured">
      <a class="featured__media" href="{{ featured.url }}" aria-label="Watch {{ featured.artist }}{% if featured.song_title %}, {{ featured.song_title }}{% endif %}">
        {% if featured.thumbnail %}
        {% set fBase = featured.thumbnail | replace(".jpg", "") %}
        <img class="media media--full"
             src="{{ fBase }}-800.webp"
             srcset="{{ fBase }}-800.webp 800w, {{ fBase }}-1280.webp 1280w"
             sizes="(max-width: 720px) 92vw, 700px"
             alt="{{ featured.artist }}"
             {% if featured.dims %}width="{{ featured.dims.width }}" height="{{ featured.dims.height }}"{% endif %}
             loading="lazy" decoding="async" />
        {% endif %}
        <span class="featured__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </a>
      <div class="featured__meta">
        <p class="featured__artist">{{ featured.artist }}</p>
        {% if featured.song_title %}<p class="featured__song">{{ featured.song_title }} by {{ featured.covers or featured.artist }}</p>{% endif %}
      </div>
      <p class="featured__links">
        <a class="home-more" href="/sessions/">See all {{ sessions.length }} sessions &rarr;</a>
        <a class="home-more" href="/sessions/artists/">Browse every artist &rarr;</a>
      </p>
    </div>
  </div>
</section>
{% endif %}

{# FEATURED INTERVIEW ——————————————————————————————————————————— #}
{% set interviewCluster = (news.storyClusters | selectattr("slug", "equalto", "interviews") | first) %}
{% if interviewCluster and interviewCluster.posts.length %}
{% set fStory = interviewCluster.posts[0] %}
<section class="section">
  <div class="container" data-section="stories">
    <header class="home-head">
      <h2 class="home-head__title">Stories</h2>
    </header>
    <div class="featured featured--story">
      <a class="featured__media" href="{{ fStory.url }}" aria-label="Read {{ fStory.title }}">
        {% if fStory.image %}<img class="media media--full" src="{{ fStory.image | img }}" alt="{{ fStory.title }}"{% if fStory.dims %} width="{{ fStory.dims.width }}" height="{{ fStory.dims.height }}"{% endif %} loading="lazy" decoding="async" />{% endif %}
      </a>
      <div class="featured__meta">
        <p class="featured__artist">{{ fStory.title }}</p>
        {% if fStory.author %}<p class="featured__song">{{ fStory.author }}</p>{% endif %}
      </div>
      <p class="featured__links">
        <a class="home-more" href="{{ fStory.url }}">Read this interview &rarr;</a>
        <a class="home-more" href="/stories/">All stories &rarr;</a>
      </p>
    </div>
  </div>
</section>
{% endif %}

{# WHERE YOUR GIFT GOES ————————————————————————————————————————— #}
<section class="section home-gift-band">
  <div class="container home-gift">
    <header class="home-head">
      <h2 class="home-head__title">Where your gift goes</h2>
      <p class="home-head__intro">Sounds of Saving is a 501(c)(3). Every dollar funds a classroom, a film, or a tour stop.</p>
      <div class="home-gift__ctas">
        <a class="btn btn--primary" href="{{ settings.donate_url }}" target="_blank" rel="noopener">{{ settings.donate_label }}</a>
        <a class="btn btn--ghost" href="/support/">Other ways to help</a>
      </div>
    </header>
    <ul class="home-gift__uses">
      <li class="home-gift__use"><b>A classroom</b><p>SoS HS in a new school: five sessions, materials, and an artist visit, at no cost to the school.</p></li>
      <li class="home-gift__use"><b>A film</b><p>A Song That Found Me at the Right Time session with an artist, produced with 988 and published where young people already are.</p></li>
      <li class="home-gift__use"><b>A tour stop</b><p>A clinician and a 988 counselor at the table, and wallet crisis cards pointing to local help where care is hard to find.</p></li>
    </ul>
  </div>
</section>

{# Randomize the hero + featured session on each page load (client-side). #}
<script id="session-pool" type="application/json">
{%- set pool = [] -%}
{%- for s in sessions -%}
  {%- if s.thumbnail -%}
    {%- set _ = pool.push({ "artist": s.artist, "song": s.song_title, "covers": s.covers, "base": (s.thumbnail | replace(".jpg", "")), "url": s.url, "kind": s.kind }) -%}
  {%- endif -%}
{%- endfor -%}
{{ pool | dump | safe }}
</script>
<script id="story-pool" type="application/json">
{%- set spool = [] -%}
{%- set ic = (news.storyClusters | selectattr("slug", "equalto", "interviews") | first) -%}
{%- if ic -%}
{%- for p in ic.posts -%}
  {%- if p.image -%}{%- set _ = spool.push({ "title": p.title, "author": p.author, "url": p.url, "img": (p.image | img) }) -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ spool | dump | safe }}
</script>
<script>
  (function () {
    var el = document.getElementById("session-pool");
    if (!el) return;
    var all;
    try { all = JSON.parse(el.textContent); } catch (e) { return; }
    if (!all.length) return;
    var pick = function (arr) { return arr[Math.floor(Math.random() * arr.length)]; };
    var produced = all.filter(function (s) { return s.kind !== "favorite" && s.kind !== "short"; });
    if (!produced.length) produced = all;
    var h = pick(produced);
    var hImg = document.querySelector(".home-hero__img");
    var hCredit = document.querySelector(".home-hero__credit");
    if (hImg && h.base) {
      hImg.srcset = h.base + "-800.webp 800w, " + h.base + "-1280.webp 1280w, " + h.base + "-1920.webp 1920w";
      hImg.src = h.base + "-1280.webp";
      hImg.alt = h.artist + " performing for Sounds of Saving";
    }
    if (hCredit) { hCredit.textContent = "Pictured: " + h.artist + (h.song ? ", “" + h.song + "”" : ""); }
    var withSong = all.filter(function (s) { return s.song; });
    var f = pick(withSong.length ? withSong : all);
    var fImg = document.querySelector(".featured__media img");
    var fLink = document.querySelector(".featured__media");
    var fArtist = document.querySelector(".featured__artist");
    var fSong = document.querySelector(".featured__song");
    if (fImg && f.base) {
      fImg.srcset = f.base + "-800.webp 800w, " + f.base + "-1280.webp 1280w";
      fImg.src = f.base + "-800.webp";
      fImg.alt = f.artist;
    }
    if (fLink && f.url) { fLink.setAttribute("href", f.url); }
    if (fArtist) { fArtist.textContent = f.artist; }
    if (fSong) {
      if (f.song) { fSong.textContent = f.song + " by " + (f.covers || f.artist); fSong.style.display = ""; }
      else { fSong.style.display = "none"; }
    }

    // Randomize the featured interview too.
    var sEl = document.getElementById("story-pool");
    var stories = [];
    if (sEl) { try { stories = JSON.parse(sEl.textContent); } catch (e) {} }
    if (stories.length) {
      var st = pick(stories);
      var stImg = document.querySelector(".featured--story .featured__media img");
      var stMedia = document.querySelector(".featured--story .featured__media");
      var stTitle = document.querySelector(".featured--story .featured__artist");
      var stAuthor = document.querySelector(".featured--story .featured__song");
      var stRead = document.querySelector(".featured--story .featured__links a");
      if (stImg && st.img) { stImg.src = st.img; stImg.alt = st.title; }
      if (stMedia && st.url) { stMedia.setAttribute("href", st.url); stMedia.setAttribute("aria-label", "Read " + st.title); }
      if (stTitle) { stTitle.textContent = st.title; }
      if (stAuthor) { if (st.author) { stAuthor.textContent = st.author; stAuthor.style.display = ""; } else { stAuthor.style.display = "none"; } }
      if (stRead && st.url) { stRead.setAttribute("href", st.url); }
    }
  })();
</script>
