---
layout: base.njk
current: home
permalink: /
title: ""
heroOverlayNav: true
eleventyComputed:
  description: "{{ (settings.seo.home or settings.meta_description) | safe }}"
ogImage: "/assets/img/ig/banner-rooftop.jpg"
ogImageAlt: "A rooftop banner reading: what song found you at the right time?"
---
{#
  Home — message-first. Section order:
  1. Hero — positioning line over a full-color artist still + three doors
  2. What we do (Artists / Schools / Community)
  3. Featured session (randomized client-side)
  4. Featured interview (randomized client-side)
  5. Where your gift goes — the closing ask, on the dark band
  Hero + featured session/interview re-personalize on each load via the pools below.
#}
{% set featured = sessions | selectattr("featured") | first %}
{% set hero = settings.hero_images | first %}

{% pageCss "index" %}

{# 1. HERO ——————————————————————————————————————————————————————— #}
<section class="home-hero">
  {% if hero.src %}
  {# The LCP image. A plain <img> rather than a <picture>, because home.js
     reassigns src/srcset once on load to pick a random frame and a <source>
     would override it. The responsive variants come from the same pipeline
     via {% heroPool %} below; a phone was downloading the full 1600px JPEG
     here, which is what put mobile LCP at eight seconds. #}
  {% heroImg hero %}
  {% endif %}
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="home-hero__inner">
    <div class="container">
      <h1 class="home-hero__title">{{ settings.hero_heading }}</h1>
      <p class="home-hero__sub">{{ settings.hero_subheading }}</p>
      <ul class="home-doors grid-3" aria-label="Where do you want to go?">
        <li><a class="home-door" href="/sessions/"><span class="home-door__q">I love music</span><span class="home-door__a">{{ "Watch artists share the song that got them through" | arrow | safe }}</span></a></li>
        <li><a class="home-door" href="/educators/"><span class="home-door__q">I work at a school</span><span class="home-door__a">{{ "Bring SoS HS, our five-session program, to your students" | arrow | safe }}</span></a></li>
        <li><a class="home-door" href="/resources/"><span class="home-door__q">I need help</span><span class="home-door__a">{{ "Resources and the 988 Lifeline" | arrow | safe }}</span></a></li>
      </ul>
    </div>
  </div>
  <p class="home-hero__credit"{% if not hero.credit %} hidden{% endif %}>{{ hero.credit }}</p>
</section>

{# 2. WHAT WE DO — Artists / Schools / Community + proof strip ———— #}
<section class="section section--paper">
  <div class="container">
    <header class="home-head">
      <h2 class="home-head__title">What we do</h2>
      <p class="home-head__intro">Young people already use music to cope. We work with the artists they trust, the schools they're in, and the shows they go to, so they can use it on purpose.</p>
    </header>
    <ul class="home-what grid-3">
      <li class="home-what--artists">
        <a class="home-what__media" href="/sessions/" aria-label="Sessions">{% respImg "/assets/img/site/living-room.jpg", { alt: "An artist playing guitar in a living room during a filmed session", sizes: "(max-width: 760px) 92vw, 340px", width: 1500, height: 1000 } %}</a>
        <h3 class="home-what__title">Artists</h3>
        <p class="home-what__copy">Song That Found Me at the Right Time: an artist covers the song that got them through a hard time and talks about what else helped. Made with the 988 Lifeline.</p>
        <a class="home-more" href="/sessions/">{{ "Watch a Session" | arrow | safe }}</a>
      </li>
      <li class="home-what--schools">
        <a class="home-what__media" href="/educators/" aria-label="For educators">{% respImg "/assets/img/site/lockers.jpg", { alt: "Two students laughing by a row of school lockers", sizes: "(max-width: 760px) 92vw, 340px", width: 1500, height: 1000 } %}</a>
        <h3 class="home-what__title">Schools</h3>
        <p class="home-what__copy">SoS HS: five sessions on coping, identity, and connection, built on the music students already listen to. Run by school staff or by us.</p>
        <a class="home-more" href="/educators/">{{ "Bring it to your school" | arrow | safe }}</a>
      </li>
      <li class="home-what--community">
        <a class="home-what__media" href="/programs/#community" aria-label="Community programs">{% respImg "/assets/img/site/cards-festival.jpg", { alt: "Young people filling in Songs That Found Me cards at a festival table", sizes: "(max-width: 760px) 92vw, 340px", width: 1500, height: 1000 } %}</a>
        <h3 class="home-what__title">Community</h3>
        <p class="home-what__copy">At tours and festivals we collect the songs that found people at the right time, with a clinician at the table and a QR code to local help.</p>
        <a class="home-more" href="/programs/#community">{{ "See the programs" | arrow | safe }}</a>
      </li>
    </ul>
  </div>
</section>

{# 3. FEATURED SESSION ——————————————————————————————————————————— #}
{% if featured %}
<section class="section section--alt">
  <div class="container">
    <header class="home-head">
      {# Same as Stories: the heading is the route to the archive, and the
         session below already links to itself from its image and its title. #}
      <h2 class="home-head__title">
        <a href="/sessions/" aria-label="Song That Found Me at the Right Time — watch all {{ sessions.length }} sessions">{{ "Song That Found Me at the Right Time" | arrow | safe }}</a>
      </h2>
      <p class="home-head__intro">An artist plays the song that carried them through a hard time, then talks about what else helped. With Sharon Van Etten, Meshell Ndegeocello, Bartees Strange, SASAMI and dozens more.</p>
    </header>
    <div class="featured">
      <a class="featured__media" href="{{ featured.url }}" aria-label="Watch {{ featured.artist }}{% if featured.song_title %}, {{ featured.song_title }}{% endif %}">
        {% if featured.thumbnail %}
        {% set fBase = featured.thumbnail | replace(".jpg", "") %}
        <img class="media media--full"
             src="{{ fBase }}-800.webp"
             srcset="{{ fBase }}-800.webp 800w, {{ fBase }}-1280.webp 1280w"
             sizes="(max-width: 720px) 92vw, 700px"
             alt="{{ featured.artist }}"
             {% if featured.dims %}width="{{ featured.dims.width }}" height="{{ featured.dims.height }}"{% endif %}
             loading="lazy" decoding="async" />
        {% endif %}
        <span class="featured__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </a>
      <div class="featured__meta">
        <a class="featured__titlelink" href="{{ featured.url }}">
          <p class="featured__artist">{{ featured.artist }}</p>
          {% if featured.song_title %}<p class="featured__song">{{ featured.song_title }} by {{ featured.covers or featured.artist }}</p>{% endif %}
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}

{# FEATURED INTERVIEW ——————————————————————————————————————————— #}
{% set interviewCluster = (news.storyClusters | selectattr("slug", "equalto", "interviews") | first) %}
{% if interviewCluster and interviewCluster.posts.length %}
{% set fStory = interviewCluster.posts[0] %}
<section class="section section--paper">
  <div class="container" data-section="stories">
    <header class="home-head">
      {# The heading is the way through to the archive, as on the Gallery — the
         article beneath it already links to itself from both its image and its
         title, so a "Read this interview" under it was a third route to a page
         you were already looking at. #}
      <h2 class="home-head__title">
        <a href="/stories/" aria-label="Stories — read every interview and feature">{{ "Stories" | arrow | safe }}</a>
      </h2>
      <p class="home-head__intro">Interviews and features on music, mental health, and what gets people through.</p>
    </header>
    <div class="featured featured--story">
      <a class="featured__media" href="{{ fStory.url }}" aria-label="Read {{ fStory.title }}">
        {% if fStory.image %}<img class="media media--full" src="{{ fStory.image | img }}" alt="{{ fStory.title }}"{% if fStory.dims %} width="{{ fStory.dims.width }}" height="{{ fStory.dims.height }}"{% endif %} loading="lazy" decoding="async" />{% endif %}
      </a>
      <div class="featured__meta">
        <a class="featured__titlelink" href="{{ fStory.url }}">
          <p class="featured__artist">{{ fStory.title }}</p>
          {% if fStory.author %}<p class="featured__song">{{ fStory.author }}</p>{% endif %}
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}

{# GALLERY ————————————————————————————————————————————————————— #}
{# Real photographs from the account, each linking back to its own post. The
   heading itself is the way through to Instagram, so the section needs no
   standing copy and no trailing follow link. #}
{% if settings.instagram_photos | length %}
<section class="section home-ig">
  <div class="container">
    <h2 class="home-head__title home-ig__title">
      <a href="{{ settings.socials.instagram }}" target="_blank" rel="noopener"
         aria-label="Gallery — follow Sounds of Saving on Instagram">{{ "Gallery" | arrow | safe }}</a>
    </h2>
    {% photoRow settings.instagram_photos %}
  </div>
</section>
{% endif %}

{# WHERE YOUR GIFT GOES ————————————————————————————————————————— #}
<section class="section home-gift-band">
  <div class="container home-gift">
    <header class="home-head">
      <h2 class="home-head__title">Where your gift goes</h2>
      <p class="home-head__intro">Sounds of Saving is a 501(c)(3). Every dollar funds a classroom, a film, or a tour stop.</p>
      <div class="home-gift__ctas">
        <a class="btn btn--primary" href="{{ settings.donate_url }}" target="_blank" rel="noopener">Donate</a>
        <a class="btn btn--ghost" href="/support/">Other ways to help</a>
      </div>
    </header>
    <ul class="home-gift__uses">
      <li class="home-gift__use"><b>A classroom</b><p>SoS HS in a new school: five sessions, materials, and an artist visit, at no cost to the school.</p></li>
      <li class="home-gift__use"><b>A film</b><p>A Song That Found Me at the Right Time session with an artist, produced with 988 and published where young people already are.</p></li>
      <li class="home-gift__use"><b>A tour stop</b><p>A clinician and a 988 counselor at the table, and wallet crisis cards pointing to local help where care is hard to find.</p></li>
    </ul>
  </div>
</section>

{# Randomize the hero + featured session on each page load (client-side). #}
<script id="hero-pool" type="application/json">
{% heroPool settings.hero_images %}
</script>
<script id="session-pool" type="application/json">
{%- set pool = [] -%}
{%- for s in sessions -%}
  {%- if s.thumbnail -%}
    {%- set _ = pool.push({ "artist": s.artist, "song": s.song_title, "covers": s.covers, "base": (s.thumbnail | replace(".jpg", "")), "url": s.url, "kind": s.kind }) -%}
  {%- endif -%}
{%- endfor -%}
{{ pool | dump | safe }}
</script>
<script id="story-pool" type="application/json">
{%- set spool = [] -%}
{%- set ic = (news.storyClusters | selectattr("slug", "equalto", "interviews") | first) -%}
{%- if ic -%}
{%- for p in ic.posts -%}
  {%- if p.image -%}{%- set _ = spool.push({ "title": p.title, "author": p.author, "url": p.url, "img": (p.image | img) }) -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ spool | dump | safe }}
</script>
<script src="/assets/js/home.js" defer></script>
