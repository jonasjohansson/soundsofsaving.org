---
layout: base.njk
pagination:
  data: news.pages
  size: 1
  alias: post
permalink: "{{ post.url }}"
# `| safe` on every field that carries human text. An eleventyComputed value
# is itself a Nunjucks template, so it autoescapes once here ("Nakazawa's" ->
# "Nakazawa&#39;s") and base.njk then escapes the ampersand again, publishing
# "Nakazawa&amp;#39;s" into <title>, description and og: tags — which is what
# Google and every social card would show. `| safe` keeps this pass raw and
# lets the final template do the single, correct escape.
eleventyComputed:
  current: "{{ post.section }}"
  title: "{{ post.title | safe }}"
  description: "{{ (post.summary or post.excerpt) | safe }}"
  ogType: "article"
  ogImage: "{{ post.image }}"
  ogImageW: "{{ post.dims.width if post.image else '' }}"
  ogImageH: "{{ post.dims.height if post.image else '' }}"
  ogImageAlt: "{{ post.title | safe }}"
---
{# Back-link + index label derived from the post's section. #}
{% set backUrl = "/stories/" if post.section == "stories" else ("/archive/" if post.section == "archive" else "/resources/#understanding-mental-health") %}
{% set backLabel = "All stories" if post.section == "stories" else ("Archive" if post.section == "archive" else "Get Help") %}
{% pageCss "newspost" %}

<article class="container post">
  <a class="post__back" href="{{ backUrl }}">&larr; {{ backLabel }}</a>

  <header class="post__head">
    <p class="post__date"><time datetime="{{ post.date }}">{{ post.date | postDate }}</time></p>
    <h1 class="post__title">{{ post.title }}</h1>
    {% if post.author %}<p class="post__author">By {{ post.author }}</p>{% endif %}
  </header>

  {% if post.image %}
  <figure class="post__hero">
    {% respImg post.image, { alt: post.title, sizes: "(max-width: 720px) 92vw, 700px", eager: true, width: post.dims.width if post.dims else null, height: post.dims.height if post.dims else null } %}
  </figure>
  {% endif %}

  <div class="post__body prose">
    {{ post.body | respBody | safe }}
  </div>

  <nav class="post__nav" aria-label="More stories">
    <a href="{{ backUrl }}">&larr; {{ backLabel }}</a>
  </nav>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": {{ post.title | dump | safe }},
  "datePublished": {{ post.date | dump | safe }},
  {% if post.author %}"author": { "@type": "Person", "name": {{ post.author | dump | safe }} },{% endif %}
  {% if post.image %}"image": [{{ (post.image | absImg) | dump | safe }}],{% endif %}
  "description": {{ (post.summary or post.excerpt) | dump | safe }},
  "publisher": { "@type": "Organization", "name": "Sounds of Saving", "url": {{ site.origin | dump | safe }} },
  "mainEntityOfPage": {{ (site.origin + post.url) | dump | safe }}
}
</script>
