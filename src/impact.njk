{#
  Impact — Phase 1 stub. Four numbers, one testimonial, a dated milestone
  list. Copy in content/pages/impact.json; sessions/resources counts there are
  hand-maintained on purpose so the page never claims more than the team has
  checked.
#}
{% set i = pages.impact %}

{% pageCss "impact" %}

<div class="container impact-page">
  <h1 class="impact-lead">{{ i.lead }}</h1>

  <ul class="impact-stats">
    {% for s in i.stats %}
    <li class="impact-stat">
      <p class="impact-stat__num">{{ s.stat }}</p>
      <p class="impact-stat__label">{{ s.label }}</p>
    </li>
    {% endfor %}
  </ul>

  {% photoRow i.photos %}

  {% if i.testimonial %}
  <figure class="impact-quote">
    <blockquote>&ldquo;{{ i.testimonial.quote }}&rdquo;</blockquote>
    <p>{{ i.testimonial.body }}</p>
    <cite>{{ i.testimonial.attribution }}</cite>
  </figure>
  {% endif %}

  <h2>Milestones</h2>
  <ol class="milestones">
    {% for m in i.milestones %}
    <li class="milestone"><span class="milestone__year">{{ m.year }}</span><p>{{ m.body }}</p></li>
    {% endfor %}
  </ol>
</div>
