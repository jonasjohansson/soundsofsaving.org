---
layout: base.njk
current: programs
permalink: /programs/
title: Programs
description: "Music is already a mental health tool. Sounds of Saving helps young people use it intentionally, through artist storytelling, a high-school program, and mental-health resources at concerts, festivals, and campuses."
ogType: website
ogImage: "/assets/img/ig/cards-wall.jpg"
ogImageAlt: "Completed Songs That Found Me cards pinned to a wall"
---
{#
  Programs — program cards grouped under the Artists / Schools / Community
  taxonomy from the 2026 one-sheet. Each card follows a fixed schema: what it is / who it's for /
  what happens / proof / one CTA. Content from content/pages/programs.json
  (CMS-editable). The 988-co-branded Sessions series leads, marked featured.
#}
{% set p = pages.programs %}

{% pageCss "programs" %}

<div class="container programs-page">
  <div class="programs-lede">
    {% for para in p.lead.split("\n\n") %}
      {% if loop.first %}<h1 class="programs-lead">{{ para | safe }}</h1>{% else %}<p class="programs-lead">{{ para | safe }}</p>{% endif %}
    {% endfor %}
  </div>

  {% if p.ctas %}
  <p class="programs-ctas">{% for c in p.ctas %}<a class="btn {% if loop.first %}btn--primary{% else %}btn--ghost{% endif %}" href="{{ c.href }}">{{ c.label }}</a>{% endfor %}</p>
  {% endif %}

  {% for group in p.groups %}
  <section class="pgroup" id="{{ group.id }}" aria-label="{{ group.label }}">
    <div class="pgroup__top">
      <div class="pgroup__head">
        <h2 class="pgroup__heading">{{ group.heading }}</h2>
        {% if group.intro %}<p class="pgroup__intro">{{ group.intro }}</p>{% endif %}
      </div>
      {% photoFigure group.photo, "pgroup__photo" %}
    </div>

    <ul class="pcards">
      {% for card in group.cards %}
      <li{% if card.featured %} class="is-featured"{% endif %}>
        <a class="pcard{% if card.featured %} pcard--featured{% endif %}"{% if card.cta %} href="{{ card.cta.href }}"{% endif %}>
        <h3 class="pcard__title">{{ card.title }}</h3>
        {% if card.cta %}<span class="pcard__go">{{ card.cta.label | arrow | safe }}</span>{% endif %}
        <div class="pcard__spec">
          <p class="pcard__dd">{{ card.body }}</p>
          {% if card.for %}<p class="pcard__dd"><strong>For:</strong> {{ card.for }}</p>{% endif %}
          {% if card.proof %}<p class="pcard__dd pcard__proof">{{ card.proof }}</p>{% endif %}
        </div>
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}

  {% if p.educators_pointer %}
  <aside class="edu-pointer" aria-label="For educators">
    <div class="edu-pointer__copy">
      <h2>{{ p.educators_pointer.title }}</h2>
      <p>{{ p.educators_pointer.body }}</p>
    </div>
    {% if p.educators_pointer.cta %}
    <a class="btn btn--primary" href="{{ p.educators_pointer.cta.href }}">{{ p.educators_pointer.cta.label }}</a>
    {% endif %}
  </aside>
  {% endif %}
</div>
